# ---- 模型连接（留空则进入 offline 模式，全流程仍可跑通）----
# 任何 OpenAI 兼容网关都可以：DeepSeek / Qwen / Moonshot / Ollama / vLLM
FDE_LLM_BASE_URL=
FDE_LLM_API_KEY=
FDE_LLM_MODEL=

# embedding 可单独指向另一家；留空则复用上面的网关，仍为空的则用离线 HashEmbedder
FDE_EMBED_BASE_URL=
FDE_EMBED_API_KEY=
FDE_EMBED_MODEL=
FDE_EMBED_DIM=1024

# ---- 运行参数 ----
FDE_HOME=./data
FDE_CORPUS=./examples/corpus
FDE_ONTOLOGY=./ontology/after_sales.yaml
FDE_TOP_K=8
FDE_TOKEN_BUDGET=2400
FDE_TENANT=demo

# ---- 拒答闸门（换语料必须重新标定，见 docs/architecture.md）----
FDE_MIN_COVERAGE=0.35
FDE_MIN_VECTOR=0.32
